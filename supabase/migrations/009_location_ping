-- Location ping tracking for sales reps
--
-- Feature: the app pings the rep's location every ~3 minutes while they're
-- working. The server stores each ping as a raw point; the frontend later
-- queries a rep's pings for a given day and draws them as a path on a map.
-- Route-efficiency prediction (a separate feature, built later) will read
-- from this same table once there's enough history to work with.
--
-- Design choices, consistent with the rest of this schema:
--   - Plain DOUBLE PRECISION lat/lng + the existing haversine_distance_meters()
--     helper (001_initial_schema.sql), same as stores/attendance/spins.
--     No PostGIS -- this app doesn't use it anywhere else, and haversine is
--     accurate enough for tracking a rep's own daily path.
--   - Raw pings only, one row per ping. No attempt to model a "path" or
--     "trip" as its own object -- that's a query/aggregation over pings
--     (e.g. GROUP BY sales_id, date), not a separate table, so it can't
--     drift out of sync with the raw data.
--   - Deliberately NOT logged to audit_logs. audit_logs exists for
--     discrete business events (login, attendance, spins); at one row
--     every 3 minutes per active rep, pings would dominate and bloat that
--     table for no real audit value. If you need a ping-volume audit
--     trail later, add it as a separate, prunable table.

CREATE TABLE public.location_pings (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  sales_id UUID NOT NULL REFERENCES public.sales(id) ON DELETE CASCADE,
  latitude DOUBLE PRECISION NOT NULL CHECK (latitude BETWEEN -90 AND 90),
  longitude DOUBLE PRECISION NOT NULL CHECK (longitude BETWEEN -180 AND 180),
  accuracy DOUBLE PRECISION,
  recorded_at TIMESTAMPTZ NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

COMMENT ON TABLE public.location_pings IS
  'Raw GPS pings from the sales app, ~1 every 3 minutes while a rep is active. A day''s path for a rep is derived by querying pings for that sales_id/date ordered by recorded_at -- not stored separately.';
COMMENT ON COLUMN public.location_pings.recorded_at IS
  'Client-reported timestamp of the GPS fix. Use this for ordering/path building, not created_at (server receipt time can lag on poor connectivity, e.g. queued offline pings flushing late).';

-- sales_id + recorded_at covers the main access pattern: "this rep's path
-- for this day" (WHERE sales_id = ? AND recorded_at BETWEEN ? AND ? ORDER BY recorded_at)
CREATE INDEX idx_location_pings_sales_id_recorded_at
  ON public.location_pings(sales_id, recorded_at DESC);

-- Separate index for admin/cross-rep queries by time range alone
-- (e.g. "everyone's pings today" for a live ops view).
CREATE INDEX idx_location_pings_recorded_at
  ON public.location_pings(recorded_at DESC);

ALTER TABLE public.location_pings ENABLE ROW LEVEL SECURITY;

-- Same shape as sales_insert_own_attendance / sales_read_own_attendance
-- in 002_rls_policies.sql: reps can write and read only their own pings,
-- admins can read everyone's.
CREATE POLICY "sales_insert_own_location_pings"
  ON public.location_pings FOR INSERT
  WITH CHECK (sales_id = auth.uid());

CREATE POLICY "sales_read_own_location_pings"
  ON public.location_pings FOR SELECT
  USING (sales_id = auth.uid() OR public.is_admin());

-- Admins get UPDATE/DELETE too (e.g. purging old pings for data retention);
-- reps never update or delete a ping once sent.
CREATE POLICY "admin_manage_location_pings"
  ON public.location_pings FOR ALL
  USING (public.is_admin())
  WITH CHECK (public.is_admin());

-- Server-side entry point for logging a ping, following the same pattern
-- as submit_attendance() / confirm_attendance_order(): a SECURITY DEFINER
-- RPC rather than a bare client .insert(), so validation lives in one
-- place and can be tightened later (e.g. rate-limiting one ping per rep
-- per N seconds) without a frontend change.
CREATE OR REPLACE FUNCTION public.log_location_ping(
  p_latitude DOUBLE PRECISION,
  p_longitude DOUBLE PRECISION,
  p_accuracy DOUBLE PRECISION DEFAULT NULL,
  p_recorded_at TIMESTAMPTZ DEFAULT now()
)
RETURNS public.location_pings
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_sales_id UUID;
  v_ping public.location_pings;
BEGIN
  v_sales_id := auth.uid();
  IF v_sales_id IS NULL THEN
    RAISE EXCEPTION 'Not authenticated';
  END IF;

  IF p_latitude IS NULL OR p_longitude IS NULL THEN
    RAISE EXCEPTION 'latitude and longitude are required';
  END IF;

  IF p_latitude NOT BETWEEN -90 AND 90 OR p_longitude NOT BETWEEN -180 AND 180 THEN
    RAISE EXCEPTION 'latitude/longitude out of range';
  END IF;

  -- Reject pings claiming to be from far in the future or implausibly
  -- old (e.g. a clock bug or a very stale offline-queued ping) rather
  -- than silently accepting bad data into the path.
  IF p_recorded_at > now() + INTERVAL '5 minutes'
     OR p_recorded_at < now() - INTERVAL '24 hours' THEN
    RAISE EXCEPTION 'recorded_at out of acceptable range';
  END IF;

  INSERT INTO public.location_pings (sales_id, latitude, longitude, accuracy, recorded_at)
  VALUES (v_sales_id, p_latitude, p_longitude, p_accuracy, p_recorded_at)
  RETURNING * INTO v_ping;

  RETURN v_ping;
END;
$$;

GRANT EXECUTE ON FUNCTION public.log_location_ping(DOUBLE PRECISION, DOUBLE PRECISION, DOUBLE PRECISION, TIMESTAMPTZ) TO authenticated;

-- Convenience read: a rep's (or, for an admin, any rep's) path for one
-- calendar day, already ordered. Not strictly required -- the frontend
-- could just SELECT ... FROM location_pings directly under RLS -- but
-- centralizing the "one day's path" query here means the ordering/date
-- boundary logic only lives in one place.
CREATE OR REPLACE FUNCTION public.get_location_path(
  p_sales_id UUID,
  p_date DATE
)
RETURNS SETOF public.location_pings
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  IF auth.uid() IS NULL THEN
    RAISE EXCEPTION 'Not authenticated';
  END IF;

  IF p_sales_id <> auth.uid() AND NOT public.is_admin() THEN
    RAISE EXCEPTION 'Not authorized to view this path';
  END IF;

  RETURN QUERY
  SELECT *
  FROM public.location_pings
  WHERE sales_id = p_sales_id
    AND recorded_at >= p_date::TIMESTAMPTZ
    AND recorded_at < (p_date + 1)::TIMESTAMPTZ
  ORDER BY recorded_at ASC;
END;
$$;

GRANT EXECUTE ON FUNCTION public.get_location_path(UUID, DATE) TO authenticated;